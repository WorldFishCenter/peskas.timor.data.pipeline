# =============================================================================
# Peskas Timor-Leste data pipeline — environment template
# =============================================================================
#
#   cp .env.example .env      then fill in the values.
#
# `.env` is gitignored and is loaded by `read_config()` (see `load_dotenv()`).
# In CI these same names come from the workflow environment, so there is no
# `.env` file there and local and CI resolve the identical configuration
# branch — they differ only by `R_CONFIG_ACTIVE`.
#
# Every value must be on ONE line. The two JSON values below (`GCP_SA_KEY`,
# `PESKAS_GMAIL_KEY`) must be minified — dotenv parses line by line.
# =============================================================================

# --- KoBoToolbox (eu.kobotoolbox.org) ----------------------------------------
# Basic auth for the survey API, plus one asset id per form generation.
#   V1  SSF Landings  frozen, last submission 2020-08-28
#   V2  peskAAS       live, low volume
#   V3  PeskAAS 2     live, the current form
#
# KOBO_TOKEN is optional: it is offered to each form alongside the username and
# password, and retrieval works on basic auth alone. CI does not set it.
KOBO_USERNAME=
KOBO_PASSWORD=
KOBO_TOKEN=
KOBO_ASSET_ID_V1=
KOBO_ASSET_ID_V2=
KOBO_ASSET_ID_V3=

# --- Google Cloud Storage ----------------------------------------------------
# The complete service-account JSON for
# data-ingestion@peskas.iam.gserviceaccount.com, minified onto one line.
# GitHub secret name: PESKAS_DATAINGESTION_GCS_KEY.
GCP_SA_KEY=

# --- Pelagic Data Systems ----------------------------------------------------
# GitHub secrets: PESKAS_PDS_TOKEN / PESKAS_PDS_SECRET.
PDS_TOKEN=
PDS_SECRET=

# --- Harvard Dataverse -------------------------------------------------------
# GitHub secret: PESKAS_DATAVERSE_TOKEN.
DATAVERSE_TOKEN=

# --- Blastula / Gmail --------------------------------------------------------
# The serialized blastula credentials object (JSON with type/value/attributes),
# minified onto one line — not a bare app password. `send_validation_mail()`
# writes this straight out as a blastula creds file.
PESKAS_GMAIL_KEY=

# --- Airtable ----------------------------------------------------------------
# The PESKAS | FRAME base is the cross-country reference layer: it maps each
# country's raw form labels to standard_name / alpha3_code / FAO codes, and
# `coasts::ingest_assets()` snapshots it for the rest of the pipeline. Timor
# reads taxa, gears, vessels, landing_sites and pds_devices from it.
#
# AIRTABLE_TOKEN must be the BARE token (`pat…`) — coasts prepends "Bearer ".
# It needs read access to the frame base and the schema.bases:read scope.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID_FRAME=

# Only needed if Timor adopts coasts::sync_device_users() (validation portal
# users, PESKAS | TRACKS base). Not used today.
# AIRTABLE_BASE_ID_TRACKS_APP=appGN7M4y0UdMRsJw
#
# Do NOT add AIRTABLE_BASE_ID_ASSETS. It appears in Mozambique's .env but is
# referenced by nothing in coasts or in any country package; the assets
# snapshot is built from the FRAME base.

# --- MongoDB -----------------------------------------------------------------
# MONGODB_CONNECTION_STRING_VALIDATION is the validation flags sink, written by
# `push_validation_flags()`. Without it the run warns and the versioned
# snapshot in cloud storage is the only record of that run's flags. Not set in
# CI yet, so the pipeline currently takes that path.
MONGODB_CONNECTION_STRING_VALIDATION=

# MONGODB_CONNECTION_STRING backs `storage.mongodb.databases.pipeline`, which
# is declared and has no reader. Leave it unset unless something starts using
# that database.
# MONGODB_CONNECTION_STRING=
