^.*\.Rproj$
^\.Rproj\.user$
^peskas\.timor\.data\.pipeline\.Rproj$
^LICENSE\.md$
^README\.Rmd$
^cran-comments\.md$
^\.github$
^codecov\.yml$
^_pkgdown\.yml$
^docs$
^pkgdown$
^Dockerfile*
^docker-compose.yaml$
^.dockerignore$
^rstudio-prefs.json$
^.DS_Store$
^peskas\.mozambique\.data\.pipeline/
^\.env$
^\.env\.example$
^\.Renviron$
^\.Rhistory$
^\.claude$
